# ── Database ──────────────────────────────────────────────────────────────────
# Optional full override. When set, it wins over every POSTGRES_* value below.
# DATABASE_URL=postgresql://user:pass@host:5432/retrieva

# Set true for a zero-setup local SQLite file (backend/retrieva.db) when you
# are not running Postgres. Leave false to use the POSTGRES_* settings — Docker
# Compose forces it false so the provisioned Postgres is actually used.
USE_SQLITE=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retrieva
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Milvus ────────────────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530
MILVUS_DEFAULT_COLLECTION=retrieva_docs

# ── LLM Providers (ordered fallback chain) ───────────────────────────────────
# Comma-separated, highest priority first. Every augmentation call (agent
# generation, metadata-filter extraction, document summarization, PDF vision
# OCR) runs through this chain: if a provider errors — no credits, rate limit,
# transient 5xx — the next is tried automatically.
#
# Providers without an API key are skipped when the chain is built, so listing
# one costs nothing until you supply its key.
LLM_FALLBACK_ORDER=gemini,anthropic,openai

# Per-provider model ids — a single LLM_MODEL cannot describe a chain whose
# members are different model families.
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=16000

# DEPRECATED. If set, this provider is promoted to the head of the chain, so
# older .env files keep their intended primary instead of silently changing.
# Prefer LLM_FALLBACK_ORDER. Leave blank to use the order above verbatim.
# LLM_PROVIDER=
# LLM_MODEL=

# Adaptive thinking. Off by default — the agent makes many short tool-routing
# calls where thinking is spend without benefit. Turn on for harder reasoning.
LLM_THINKING_ENABLED=false
# low | medium | high | xhigh | max. Blank uses the server default (high).
LLM_EFFORT=

# NOTE: ignored on Claude 5 / Opus 4.7+ models, which reject sampling
# parameters with a 400. Applies only to the gemini/openai fallback paths.
LLM_TEMPERATURE=0.0

# ── Embeddings ("ollama" | "gemini" | "openai") ──────────────────────────────
# Anthropic serves no embeddings endpoint, so vectors come from a local
# open-source model via Ollama. Pull it first:  ollama pull nomic-embed-text
#
#   nomic-embed-text  ->  EMBEDDING_DIM=768   (default: small, fast)
#   bge-m3            ->  EMBEDDING_DIM=1024  (larger, better multilingual)
#
# EMBEDDING_DIM MUST match the model. It is baked into the Milvus collection
# schema at creation time — changing the model means changing this value AND
# re-ingesting into a fresh collection.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Ollama runs natively on the HOST, not in Docker — the container stack already
# saturates the WSL2 VM's memory on a small machine, and an in-VM Ollama pushed
# it over the edge. Install once:
#     winget install Ollama.Ollama
#     ollama pull nomic-embed-text
#
# Host-side value (running the backend outside Docker):
OLLAMA_BASE_URL=http://localhost:11434
# Inside Docker the compose file overrides this with
# http://host.docker.internal:11434 automatically.

# ── API Keys ─────────────────────────────────────────────────────────────────
# Required — Claude powers all generation.
ANTHROPIC_API_KEY=

# Only needed if you switch LLM_PROVIDER/EMBEDDING_PROVIDER away from the
# defaults above.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Observability (Langfuse) ─────────────────────────────────────────────────
# Traces every agent run, tool call, retrieval, and LLM generation.
#
# Opt-in and fail-open: leave the keys blank and tracing stays inert — chat and
# ingestion are unaffected. Any error inside the tracing layer is swallowed
# rather than allowed to break a request.
#
# RECOMMENDED ON THIS MACHINE: Langfuse Cloud (free tier, zero local RAM).
#   1. Sign up at https://cloud.langfuse.com and create a project
#   2. Paste its keys below
# Self-hosting needs ClickHouse + web + worker (~3-4 GB) and will not fit
# alongside the Retrieva stack in a 3.5 GB WSL2 VM — see
# docker-compose.langfuse.yml before attempting it.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud (default): https://cloud.langfuse.com
# US cloud:           https://us.cloud.langfuse.com
# Self-hosted:        http://langfuse-web:3000
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Retrieval ─────────────────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true

# Cross-encoder reranking. Requires the optional `sentence-transformers`
# package, which is NOT installed by default (it pulls torch, plus ~3 GB of
# Linux CUDA libraries). Setting this true without the package logs a warning
# and leaves results unranked.
#
#   Local:   poetry install --extras rerank
#   Docker:  INSTALL_RERANK=true docker compose build backend
#            (uses the CPU-only torch wheel, ~200 MB)
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=9090
